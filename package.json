{
  "name": "orbitdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run --exclude tests/browser/**",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "vitest": "5.0.5",
    "@types/google-apps-script": "latest",
    "@types/node": "latest",
    "@playwright/test": "latest"
  }
}
